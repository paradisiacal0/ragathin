  <script>
    function openOffer(seller) {
      document.getElementById('offer-seller-name').textContent = '— ' + seller + ' —';
      document.getElementById('offer-overlay').classList.add('active');
      setTimeout(() => document.getElementById('offer-input').focus(), 50);
    }

    function closeOffer() {
      document.getElementById('offer-overlay').classList.remove('active');
      document.getElementById('offer-input').value = '';
    }

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeOffer();
    });
  </script>

